<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{ cv.name }} CV</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Lato:ital,wght@0,400;0,700;0,900;1,400&display=swap" rel="stylesheet">
<style>
  * { box-sizing: border-box; }
  body { margin: 0; font-family: Lato, "Helvetica Neue", Arial, sans-serif; font-size: 9.4pt; line-height: 1.3;
         color: #1a1a1a; background: #fff; }
  header { text-align: center; margin-bottom: 5pt; }
  h1 { margin: 0; font-size: 21pt; font-weight: 900; letter-spacing: 2.5pt; text-transform: uppercase; }
  .headline { margin-top: 2pt; font-size: 11pt; color: #444; }
  .contact { margin-top: 2pt; font-size: 8.8pt; color: #555; }
  h2 { margin: 7pt 0 3pt; padding-bottom: 2pt; border-bottom: 0.8pt solid #999; font-size: 10pt;
       font-weight: 900; letter-spacing: 1.2pt; text-transform: uppercase; }
  p { margin: 0; }
  .skills p { margin-bottom: 1.5pt; }
  .job { margin-bottom: 3pt; }
  .company { font-weight: 700; }
  .muted { color: #666; }
  .role { margin-top: 3pt; font-weight: 700; }
  .role .dates { font-weight: 400; font-style: italic; color: #666; }
  ul { margin: 1.5pt 0 0; padding-left: 12pt; }
  li { margin-bottom: 1.4pt; }
  .projects p { margin-bottom: 2pt; }
  .sep { color: #888; padding: 0 3pt; }
</style>
</head>
<body>
<header>
  <h1>{{ cv.name }}</h1>
  <div class="headline">{{ cv.headline }}</div>
  {% for line in cv.contact %}
  <div class="contact">{% for part in line %}{% if not loop.first %}<span class="sep">·</span>{% endif %}{{ part }}{% endfor %}</div>
  {% endfor %}
</header>

<h2>Summary</h2>
<p>{{ cv.summary }}</p>

<h2>Technical skills</h2>
<div class="skills">
{% for g in cv.skills %}
  <p><b>{{ g.label }}:</b> {{ g["items"] }}</p>
{% endfor %}
</div>

<h2>Experience</h2>
{% for job in cv.experience %}
<div class="job">
  <div><span class="company">{{ job.company }}</span>{% if job.where %}<span class="sep">·</span><span class="muted">{{ job.where }}</span>{% endif %}</div>
  {% for role in job.roles %}
  <div class="role">{{ role.title }}<span class="sep">·</span><span class="dates">{{ role.dates }}</span></div>
  {% if role.bullets %}
  <ul>{% for b in role.bullets %}<li>{{ b }}</li>{% endfor %}</ul>
  {% endif %}
  {% endfor %}
</div>
{% endfor %}

<h2>Personal projects</h2>
<div class="projects">
{% for p in cv.projects %}
  <p><b>{{ p.name }}:</b> {{ p.text }}</p>
{% endfor %}
</div>

{% if cv.education %}
<h2>Education</h2>
{% for e in cv.education %}
<p><b>{{ e.school }}</b><span class="sep">·</span><span class="muted">{{ e.field }}</span><span class="sep">·</span><span class="muted">{{ e.dates }}</span></p>
{% endfor %}
{% endif %}
</body>
</html>
